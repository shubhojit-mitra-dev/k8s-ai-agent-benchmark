# Cloudflare Workers AI Credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter Credentials
OPENROUTER_API_KEY=

# Benchmark Configuration
BENCHMARK_MODE=quick
DEFAULT_REASONING_EFFORT=high
MAX_STEPS_PER_INCIDENT=20
TIMEOUT_SECONDS_PER_INCIDENT=120
HTTP_REQUEST_TIMEOUT_SECONDS=15

# Provider Models
CF_SONNET_MODEL=anthropic/claude-sonnet-5
CF_JEV_MODEL=typesafe/jev
OR_SONNET_MODEL=anthropic/claude-sonnet-5
OR_JEV_MODEL=~typesafe/jev-latest

# OpenRouter Routing Mode (default, latency-oriented, pinned-provider)
OPENROUTER_ROUTING_MODE=default

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
